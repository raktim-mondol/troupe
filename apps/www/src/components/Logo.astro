---
type Props = {
  href?: string;
};

const { href = "/" } = Astro.props as Props;
---

<a class="brand-lockup" href={href} aria-label="Troupe home">
  <img
    class="brand-lockup__mark"
    src="/brand/troupe-mark.svg"
    width="36"
    height="36"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__word">troupe</span>
</a>
